@startuml
actor Student
participant ":StudentDashboardUI" as UI <<boundary>>
participant ":ReservationControl" as Ctrl <<control>>
participant "spot : ParkingSpot" as Spot <<entity>>
participant "res : Reservation" as Res <<entity>>
participant ":LprGateBoundary" as LPR <<boundary>>

Student -> UI : onReserveSpotClicked("EV-04", "12-345-67")
activate UI
UI -> Ctrl : reserveSpot(userId, "EV-04", "12-345-67")
activate Ctrl
Ctrl -> Spot : isAvailable()
activate Spot
Spot --> Ctrl : available
deactivate Spot

alt available == true
  Ctrl -> Spot : getVersion()
  activate Spot
  Spot --> Ctrl : currentVersion
  deactivate Spot
  Ctrl -> Spot : tryReserve(currentVersion)
  activate Spot
  Spot --> Ctrl : acquired
  deactivate Spot
  alt acquired == true
    Ctrl -> Spot : setStatus(RESERVED)
    create Res
    Ctrl -> Res : <<create>> Reservation(userId, "EV-04", 15)
    Ctrl --> UI : res
    UI -> UI : displayCountdown(15)
  else acquired == false (Concurrent Race Condition)
    Ctrl --> UI : null
    UI -> UI : showErrorAlert("Spot just reserved by another user")
  end
else available == false
  Ctrl --> UI : null
  UI -> UI : showErrorAlert("Spot unavailable")
end
deactivate Ctrl
deactivate UI

== Within 15 Minutes: Vehicle Arrives at Entrance Gate ==

LPR -> Ctrl : processLprGateEntry("12-345-67", "EV Zone")
activate Ctrl
Ctrl -> Res : isWithin15MinWindow()
activate Res
Res --> Ctrl : valid
deactivate Res

alt valid == true
  Ctrl -> Res : setStatus(FULFILLED)
  Ctrl -> LPR : openBarrierGate()
else No-Show > 15 Min
  Ctrl -> Res : setStatus(NO_SHOW_REVOKED)
  destroy Res
  Ctrl -> LPR : denyEntry()
end
deactivate Ctrl
@enduml
